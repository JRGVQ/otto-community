# ─────────────────────────────────────────────────────────────────────────────
# Otto — production configuration for docker compose.
# Copy to `.env` next to docker-compose.yml and fill it in. Never commit the
# filled-in .env. Every setting is documented in INSTALL.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# The public https address of your Otto installation (no trailing slash). Used for
# OAuth redirect URIs, links in e-mails, webhooks and the Outlook add-in.
PUBLIC_BASE_URL=https://otto.example.com

# Domain for the bundled Caddy proxy (`docker compose --profile caddy`), without https://.
OTTO_DOMAIN=otto.example.com

# PostgreSQL password.  openssl rand -base64 24
POSTGRES_PASSWORD=

# Secrets. Leave empty and the container generates them on first start and keeps
# them in the `otto_data` volume — or (recommended) generate your own and keep a copy
# in your password manager. NEVER change TOKEN_ENCRYPTION_KEY once in use: it encrypts
# the stored mailbox tokens and AI keys.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── System e-mail (verification, password reset, invitations) ───────────────
# Without a mailer, nobody can verify an address or reset a password by e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=Otto <otto@example.com>
# Alternative: send through Microsoft 365 with an app-only registration (see INSTALL.md):
# MAIL_PROVIDER=graph
# GRAPH_MAIL_TENANT_ID=
# GRAPH_MAIL_CLIENT_ID=
# GRAPH_MAIL_CLIENT_SECRET=
# GRAPH_MAIL_SENDER=otto@example.com

# ── AI model ─────────────────────────────────────────────────────────────────
# stub = no AI (simple built-in rules + placeholder drafts). Organisations can also
# add their own key in the app under Beheer → AI & model.
LLM_PROVIDER=stub
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# LLM_MODEL=
# Optional monthly AI budget per organisation on the key above (EUR). Unset = no cap.
# LLM_MONTHLY_BUDGET_EUR=50

# ── Mailbox providers (OAuth apps — see INSTALL.md) ─────────────────────────
# Microsoft 365: redirect URI  <PUBLIC_BASE_URL>/auth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
# Gmail / Google Workspace: redirect URI  <PUBLIC_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Accounts ─────────────────────────────────────────────────────────────────
# Self-registration is off: the first visitor completes the setup and becomes the
# administrator; afterwards the administrator creates organisations in /owner.
# REGISTRATION_OPEN=0
# Pin the /owner backoffice to one e-mail address (optional).
# PLATFORM_OWNER_EMAIL=

# ── Optional ─────────────────────────────────────────────────────────────────
# Realtime Microsoft 365 sync via Graph webhooks (otherwise: polling).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# GRAPH_CLIENT_STATE=
# Realtime Gmail sync via Pub/Sub (all three, otherwise: polling).
# GMAIL_PUBSUB_TOPIC=projects/<project-id>/topics/<topic>
# GMAIL_PUSH_AUDIENCE=https://otto.example.com/api/webhooks/gmail
# GMAIL_PUSH_SA_EMAIL=
# Seed the fictional demo organisation (Acme NV) — for trying Otto out only.
SEED_DEMO=0
# UI language default (nl, fr or en) and timezone.
# BABEL_DEFAULT_LOCALE=nl
# APP_TIMEZONE=Europe/Brussels
# Error tracking.
# SENTRY_DSN=
# Gunicorn workers for the web container.
# WEB_CONCURRENCY=2
