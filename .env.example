# ─────────────────────────────────────────────────────────────────────────────
# Otto — local development configuration.
# Copy to `.env`. Every value has a safe local default in app/config.py, so the app
# runs out-of-the-box with this file left as-is (SQLite, no AI, no mailbox provider).
# For production use .env.production.example and see INSTALL.md.
# ─────────────────────────────────────────────────────────────────────────────

FLASK_CONFIG=dev
PUBLIC_BASE_URL=http://localhost:5000

# Leave empty for the built-in development values. Set real ones in production.
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# ── Database ────────────────────────────────────────────────────────────────
# Leave unset for local SQLite (instance/otto.db), or use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://otto:otto@localhost:5432/otto

# ── Background tasks ─────────────────────────────────────────────────────────
# Unset => tasks run in-process and a built-in scheduler polls the mailboxes.
# Set to use a Celery worker + beat instead:
# REDIS_URL=redis://localhost:6379/0

# ── AI model ─────────────────────────────────────────────────────────────────
# stub => deterministic offline generator. Set a provider + key for real drafts:
LLM_PROVIDER=stub
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
# OPENAI_API_KEY=

# ── Mailbox providers (OAuth) ────────────────────────────────────────────────
# Leave blank to explore with the demo data. Redirect URIs for local testing:
#   http://localhost:5000/auth/microsoft/callback
#   http://localhost:5000/auth/google/callback   (also set OAUTHLIB_INSECURE_TRANSPORT=1)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── E-mail ───────────────────────────────────────────────────────────────────
# Without SMTP the dev config shows verification/reset links on screen.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Otto <otto@example.com>
