msgid ""
"{{inviter}} heeft je uitgenodigd om mee te werken in de Otto-omgeving van"
" <strong>{{company}}</strong>. Otto sorteert je mail en zet "
"conceptantwoorden in jouw stijl klaar."
msgstr ""
"{{inviter}} has invited you to collaborate in the Otto environment of "
"<strong>{{company}}</strong>. Otto sorts your email and prepares draft "
"replies in your style."

