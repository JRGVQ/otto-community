#: app/web/context/admin.py:579
msgid "Meld je aan of maak een account op console.anthropic.com."
msgstr "Connectez-vous ou créez un compte sur console.anthropic.com."

#: app/web/context/admin.py:580
msgid "Ga naar Settings → API Keys en klik “Create Key”."
msgstr "Allez dans Settings → API Keys et cliquez sur « Create Key »."

#: app/web/context/admin.py:581
msgid "Kopieer de sleutel (begint met sk-ant-) en plak ze bij API-sleutel."
msgstr "Copiez la clé (commence par sk-ant-) et collez-la dans Clé API."

#: app/web/context/admin.py:582
msgid ""
"Voeg tegoed toe onder Billing — je betaalt je verbruik rechtstreeks bij "
"Anthropic."
msgstr ""
"Ajoutez du crédit sous Billing — vous payez votre consommation "
"directement chez Anthropic."

#: app/web/context/admin.py:588
msgid "Meld je aan op platform.openai.com."
msgstr "Connectez-vous sur platform.openai.com."

#: app/web/context/admin.py:589
msgid "Open “API keys” en klik “Create new secret key”."
msgstr "Ouvrez « API keys » et cliquez sur « Create new secret key »."

#: app/web/context/admin.py:590
msgid "Kopieer de sleutel (begint met sk-) en plak ze bij API-sleutel."
msgstr "Copiez la clé (commence par sk-) et collez-la dans Clé API."

#: app/web/context/admin.py:591
msgid "Voeg een betaalmethode of tegoed toe onder Billing."
msgstr "Ajoutez un moyen de paiement ou du crédit sous Billing."

#: app/web/context/admin.py:597
msgid ""
"Maak in Azure een “Azure OpenAI”-resource aan (kies een EU-regio voor "
"dataresidentie)."
msgstr ""
"Créez dans Azure une ressource « Azure OpenAI » (choisissez une région UE"
" pour la résidence des données)."

#: app/web/context/admin.py:598
msgid ""
"Deploy een model (bv. gpt-4o) — de deployment-naam vul je hierboven in "
"als model."
msgstr ""
"Déployez un modèle (p. ex. gpt-4o) — saisissez le nom du déploiement ci-"
"dessus comme modèle."

#: app/web/context/admin.py:599
msgid "Kopieer onder “Keys and Endpoint” een sleutel én de endpoint-URL."
msgstr "Sous « Keys and Endpoint », copiez une clé et l'URL de l'endpoint."

#: app/web/context/admin.py:600
msgid "Plak de sleutel bij API-sleutel en de endpoint bij Base-URL."
msgstr "Collez la clé dans Clé API et l'endpoint dans Base-URL."

#: app/web/context/admin.py:610
msgid ""
"Kies een aanbieder met een OpenAI-compatibele API (OpenRouter, Google "
"Gemini, Mistral, Groq of lokaal/Ollama)."
msgstr ""
"Choisissez un fournisseur avec une API compatible OpenAI (OpenRouter, "
"Google Gemini, Mistral, Groq ou local/Ollama)."

#: app/web/context/admin.py:611
msgid "Haal daar een API-sleutel op via een van de knoppen hieronder."
msgstr "Récupérez-y une clé API via l'un des boutons ci-dessous."

#: app/web/context/admin.py:612
msgid ""
"Plak de sleutel bij API-sleutel en zet de Base-URL van die aanbieder bij "
"Endpoint (bv. https://openrouter.ai/api/v1)."
msgstr ""
"Collez la clé dans Clé API et indiquez la Base-URL de ce fournisseur dans"
" Endpoint (p. ex. https://openrouter.ai/api/v1)."

#: app/web/context/admin.py:613
msgid "Vul het model-id in zoals de aanbieder het noemt."
msgstr "Saisissez l'identifiant du modèle tel que le fournisseur le nomme."

#: app/web/context/admin.py:622
msgid "Data in EU, GPT-klasse kwaliteit. Aanbevolen voor BE/EU."
msgstr "Données en UE, qualité de classe GPT. Recommandé pour BE/UE."

#: app/web/context/admin.py:623
msgid "Snelste start, hoge kwaliteit. Let op datalocatie & DPA."
