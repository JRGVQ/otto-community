msgstr "une par ligne, max. 5 — Otto écrit sur ce ton"

#: app/templates/app/user/settings.html:240
msgid "Otto vult dit zelf aan zodra je een paar antwoorden hebt verstuurd."
msgstr "Otto complète ceci de lui-même dès que vous avez envoyé quelques réponses."

#: app/templates/app/user/settings.html:242
msgid "Schrijfstijl opslaan"
msgstr "Enregistrer le style d'écriture"

#: app/templates/app/user/settings.html:247
msgid "Opnieuw leren uit mijn verzonden mail"
msgstr "Réapprendre à partir de mes e-mails envoyés"

#: app/templates/app/user/settings.html:253
