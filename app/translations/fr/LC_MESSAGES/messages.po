#: app/email.py:137
msgid ""
"De link verloopt na 1 uur. Heb je dit niet aangevraagd? Negeer deze "
"e-mail."
msgstr ""
"Le lien expire après 1 heure. Vous n'êtes pas à l'origine de cette "
"demande ? Ignorez cet e-mail."

#: app/email.py:141
msgid "Teamlid-uitnodiging"
msgstr "Invitation d'un membre d'équipe"

#: app/email.py:142
msgid "Naar een collega die door een beheerder wordt uitgenodigd."
msgstr "À un collègue invité par un administrateur."

#: app/email.py:146
msgid "{{inviter}} nodigt je uit voor Otto bij {{company}}"
msgstr "{{inviter}} vous invite à rejoindre Otto chez {{company}}"

#: app/email.py:148
msgid "Je bent uitgenodigd 🎉"
msgstr "Vous êtes invité 🎉"

#: app/email.py:149
msgid "Hallo,"
msgstr "Bonjour,"

#: app/email.py:150
msgid ""
"{{inviter}} heeft je uitgenodigd om mee te werken in de Otto-omgeving van"
" <strong>{{company}}</strong>. Otto sorteert je mail en zet "
"conceptantwoorden in jouw stijl klaar."
msgstr ""
"{{inviter}} vous a invité à collaborer dans l'environnement Otto de "
"<strong>{{company}}</strong>. Otto trie vos e-mails et prépare des "
"brouillons de réponse dans votre style."

#: app/email.py:153 app/templates/auth/invite.html:2
msgid "Uitnodiging accepteren"
msgstr "Accepter l'invitation"

#: app/email.py:155
msgid ""
"De link verloopt na 48 uur. Verwacht je deze uitnodiging niet? Negeer "
"deze e-mail."
msgstr ""
"Le lien expire après 48 heures. Vous n'attendiez pas cette invitation ? "
"Ignorez cet e-mail."

#: app/email.py:159
msgid "Omgeving verwijderd (bevestiging)"
msgstr "Environnement supprimé (confirmation)"

#: app/email.py:160
msgid "Naar de eigenaar wanneer die zijn eigen Otto-omgeving verwijdert."
msgstr "Au propriétaire lorsqu'il supprime son propre environnement Otto."

#: app/email.py:163
msgid "Je Otto-omgeving voor {{company}} is verwijderd"
msgstr "Votre environnement Otto pour {{company}} a été supprimé"

#: app/email.py:165
msgid "Omgeving verwijderd"
msgstr "Environnement supprimé"

#: app/email.py:167
msgid ""
"Je Otto-omgeving voor <strong>{{company}}</strong> is verwijderd. We "
"bewaren je gegevens nog <strong>{{restore_days}} dagen</strong> — daarna "
"worden ze definitief gewist."
msgstr ""
"Votre environnement Otto pour <strong>{{company}}</strong> a été "
"supprimé. Nous conservons vos données encore <strong>{{restore_days}} "
"jours</strong> — elles seront ensuite définitivement effacées."

#: app/email.py:170
msgid ""
"Van gedacht veranderd? Vraag de beheerder van je Otto-installatie binnen "
"die termijn om alles terug te zetten."
msgstr ""
"Vous avez changé d'avis ? Demandez à l'administrateur de votre "
"installation Otto de tout restaurer dans ce délai."

